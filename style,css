* {
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

:root {
  --bg: #eef4f8;
  --surface: #ffffff;
  --surface-soft: #eef4f8;
  --surface-soft-2: #f7fafc;
  --text: #20334d;
  --text-soft: #56677d;
  --text-muted: #718196;
  --line: #d9e3ee;
  --line-soft: #eef3f7;
  --primary: #3366ff;
  --primary-dark: #244bba;
  --primary-soft: #dde7ff;
  --secondary: #35b79d;
  --secondary-dark: #176e61;
  --secondary-soft: #dffbf7;
  --ai: #8768f8;
  --ai-soft: #efeaff;
  --warning: #ffb24d;
  --warning-soft: #ffeedd;
  --danger: #ef6666;
  --danger-soft: #ffecef;
  --success: #40b986;
  --success-soft: #ddf8ee;
  --blue: #4bb5ff;
  --cloud: #76b7e8;
  --web: #54b4aa;
  --firebase: #ffb3a7;
  --data: #a180e7;
  --ai-color: #8768f8;
  --shadow: rgba(54, 78, 112, 0.12);
  --font: "Inter", "Segoe UI", "Roboto", Arial, sans-serif;
}

body {
  margin: 0;
  font-family: var(--font);
  color: var(--text);
  background: var(--bg);
  line-height: 1.55;
}

body::before {
  content: "";
  position: fixed;
  width: 420px;
  height: 420px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(51, 102, 255, 0.12), transparent 70%);
  filter: blur(70px);
  left: -80px;
  top: -120px;
  pointer-events: none;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  border: none;
  cursor: pointer;
}

.app-shell {
  min-height: 100vh;
  display: flex;
}

.sidebar {
  width: 280px;
  background: var(--text);
  color: #eef6ff;
  padding: 30px 24px;
  position: sticky;
  top: 0;
  height: 100vh;
  flex-shrink: 0;
  box-shadow: 6px 0 30px var(--shadow);
}

.brand-wrap {
  margin-bottom: 34px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #eef6ff;
}

.brand-icon {
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--primary);
  color: white;
  box-shadow: 0 10px 25px rgba(51, 102, 255, 0.26);
}

.brand-text {
  font-size: 1.36rem;
  font-weight: 800;
  letter-spacing: -0.03em;
}

.icon-svg {
  width: 22px;
  height: 22px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 14px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255,255,255,0.08);
  margin-bottom: 22px;
}

.user-avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--ai));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  font-weight: 700;
}

.user-label {
  display: block;
  font-size: 0.74rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.user-name {
  font-size: 1rem;
  font-weight: 700;
  color: #fff;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-top: 26px;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  border-radius: 12px;
  color: #dceaff;
  font-size: 0.94rem;
  transition: all 0.22s ease;
}

.nav-link:nth-child(n+1)::before {
  content: "";
}

.nav-link .nav-icon {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-link:hover,
.nav-link.active {
  background: rgba(51, 102, 255, 0.24);
  color: white;
  border-left: 3px solid var(--primary);
  padding-left: 11px;
}

.sidebar-footer {
  position: absolute;
  bottom: 30px;
  left: 24px;
  right: 24px;
}

.ai-note {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--text-muted);
  font-size: 0.74rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  border-top: 1px solid rgba(255,255,255,0.08);
  padding-top: 18px;
}

.pulse-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  display: inline-block;
  background: var(--success);
  box-shadow: 0 0 0 3px rgba(64,185,134,0.14);
}

.gdg-note {
  margin-top: 14px;
}

.note-label {
  color: #fff;
  font-size: 0.78rem;
  background: rgba(255,255,255,0.08);
  border-radius: 20px;
  padding: 8px 12px;
}

.main-content {
  flex: 1;
  padding: 26px 40px 80px;
  background: var(--bg);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 14px 0 24px;
}

.topbar-left {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.crumb {
  color: var(--text-muted);
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.topbar-left h1 {
  margin: 0;
  font-size: clamp(2rem, 3vw, 2.8rem);
  line-height: 1.2;
  letter-spacing: -0.045em;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.icon-button {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-button {
  background: var(--primary);
  color: white;
  border-radius: 14px;
  font-weight: 700;
  padding: 12px 22px;
  font-size: 0.92rem;
  box-shadow: 0 10px 20px rgba(51,102,255,0.16);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.primary-button:hover {
  background: var(--primary-dark);
  transform: translateY(-2px);
}

.small-button {
  padding: 11px 16px;
  font-size: 0.86rem;
}

.button-plus {
  margin-right: 8px;
}

.page-section {
  background: var(--surface-soft-2);
  padding: 28px;
  border-radius: 24px;
  border: 1px solid var(--line-soft);
  margin-top: 20px;
  box-shadow: 0 20px 60px var(--shadow);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 20px;
}

.section-header h2 {
  margin: 10px 0 0;
  font-size: clamp(1.6rem, 2vw, 2rem);
  line-height: 1.36;
  letter-spacing: -0.035em;
}

.section-kicker {
  color: var(--primary);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.section-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.status-chip,
.demo-chip {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--success-soft);
  color: var(--secondary-dark);
  border-radius: 20px;
  padding: 10px 14px;
  font-size: 0.78rem;
  font-weight: 700;
}

.chip-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--success);
}

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(420px, 1.5fr) minmax(380px, 1fr);
  gap: 22px;
}

.dashboard-card,
.event-card,
.guide-card,
.assistant-output,
.pulse-form-card,
.insights-card,
.lead-insight-panel,
.stat-card {
  background: var(--surface);
  padding: 24px;
  border-radius: 20px;
  border: 1px solid var(--line-soft);
  box-shadow: 0 4px 12px var(--shadow);
}

.welcome-card {
  background: linear-gradient(150deg, var(--surface), var(--surface-soft));
}

.welcome-content h2 {
  margin: 16px 0 8px;
  font-size: clamp(2rem, 2.5vw, 2.4rem);
  line-height: 1.2;
  letter-spacing: -0.035em;
}

.intro-text {
  color: var(--text-soft);
  font-size: 1rem;
  margin: 0 0 24px;
}

.interest-cloud {
  margin-top: 22px;
}

.interest-label,
.mini-label {
  color: var(--text-muted);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  margin-top: 14px;
}

.tag {
  background: var(--surface-soft);
  color: var(--text);
  border-radius: 20px;
  padding: 8px 14px;
  font-size: 0.78rem;
  font-weight: 700;
}

.cloud-tag {
  background: var(--cloud);
  color: white;
}

.ai-tag {
  background: var(--ai-color);
  color: white;
}

.web-tag {
  background: var(--web);
  color: white;
}

.firebase-tag {
  background: var(--firebase);
  color: var(--text);
}

.recommended-next {
  margin-top: 28px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 20px;
}

.recommended-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.impact-score {
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 20px;
  padding: 8px 12px;
}

.score-number {
  font-weight: 800;
}

.score-text {
  font-size: 0.75rem;
}

.recommended-next h3 {
  font-size: 1.36rem;
  color: var(--text);
  margin: 16px 0 8px;
}

.recommended-text {
  color: var(--text-soft);
  font-size: 0.9rem;
  margin: 0 0 16px;
}

.recommended-actions {
  display: flex;
  gap: 12px;
  align-items: center;
}

.link-button {
  color: var(--primary);
  font-weight: 700;
  border-bottom: 2px solid var(--primary);
}

.secondary-button {
  background: var(--surface-soft);
  color: var(--text);
  border-radius: 14px;
  padding: 11px 16px;
  font-weight: 700;
  font-size: 0.84rem;
  border: 1px solid var(--line);
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.panel-heading h3 {
  margin: 8px 0 0;
  font-size: 1.22rem;
  letter-spacing: -0.025em;
}

.icon-chip {
  color: var(--primary);
  padding: 9px 12px;
  border-radius: 14px;
  background: var(--primary-soft);
  font-size: 0.72rem;
  font-weight: 800;
}

.events-list {
  margin-top: 22px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.event-item {
  display: flex;
  align-items: center;
  gap: 16px;
  border-bottom: 1px solid var(--line-soft);
  padding-bottom: 14px;
}

.event-item:last-child {
  border-bottom: none;
}

.event-date-box {
  min-width: 78px;
  padding: 12px 14px;
  border-radius: 16px;
  background: var(--surface-soft);
  border: 1px solid var(--line-soft);
  text-align: center;
}

.event-date {
  font-size: 1rem;
  font-weight: 800;
  color: var(--primary);
}

.event-day {
  display: block;
  font-size: 0.76rem;
  color: var(--text-muted);
}

.event-topic {
  font-size: 0.74rem;
  font-weight: 800;
  color: var(--primary);
  text-transform: uppercase;
}

.event-details {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.event-title {
  font-size: 0.96rem;
  font-weight: 700;
  color: var(--text);
}

.event-meta {
  color: var(--text-muted);
  font-size: 0.76rem;
}

.cloud-topic {
  color: var(--cloud);
}

.ai-topic {
  color: var(--ai);
}

.web-topic {
  color: var(--web);
}

.quick-actions {
  margin-top: 26px;
}

.quick-action-list {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 14px;
}

.quick-button {
  background: var(--surface-soft);
  color: var(--text);
  padding: 10px 14px;
  border-radius: 14px;
  font-size: 0.82rem;
  font-weight: 700;
  border: 1px solid var(--line);
}

.quick-icon {
  margin-right: 7px;
}

.events-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(190px, 1fr));
  gap: 16px;
}

.event-card {
  background: var(--surface);
  padding: 20px;
  border-radius: 20px;
  border: 1px solid var(--line-soft);
}

.event-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.event-card-tag {
  color: white;
  font-size: 0.74rem;
  font-weight: 800;
  border-radius: 12px;
  padding: 8px 12px;
}

.beginner-badge {
  background: var(--success-soft);
  color: var(--secondary-dark);
  font-size: 0.72rem;
  font-weight: 800;
  padding: 7px 10px;
  border-radius: 12px;
}

.event-card-body h3 {
  margin: 26px 0 14px;
  font-size: 1.24rem;
}

.event-meta-line {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--text-muted);
  font-size: 0.82rem;
}

.meta-icon {
  color: var(--primary);
}

.event-card-text {
  color: var(--text-soft);
  font-size: 0.86rem;
  min-height: 84px;
}

.event-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  border-top: 1px solid var(--line-soft);
  padding-top: 14px;
}

.event-level {
  color: var(--text-muted);
  font-size: 0.78rem;
  font-weight: 700;
}

.register-button {
  background: var(--text);
  color: white;
  padding: 10px 14px;
  border-radius: 12px;
  font-weight: 700;
  font-size: 0.78rem;
}

.guide-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(180px, 1fr));
  gap: 16px;
}

.guide-card {
  background: var(--surface);
  padding: 22px 18px;
}

.guide-card-head {
  display: flex;
  align-items: center;
  gap: 14px;
}

.guide-icon {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 1rem;
  font-weight: 800;
}

.ai-icon {
  background: var(--ai-color);
}

.cloud-icon {
  background: var(--cloud);
}

.web-icon {
  background: var(--web);
}

.data-icon {
  background: var(--data);
}

.firebase-icon {
  background: var(--firebase);
  color: var(--text);
}

.guide-title {
  font-size: 0.96rem;
  font-weight: 800;
}

.guide-content {
  margin-top: 20px;
}

.guide-summary {
  color: var(--text-soft);
  font-size: 0.84rem;
  line-height: 1.65;
  margin: 0 0 14px;
}

.guide-summary strong {
  color: var(--text);
}

.assistant-grid {
  display: grid;
  grid-template-columns: minmax(280px, 0.75fr) minmax(420px, 1.25fr);
  gap: 20px;
}

.assistant-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.form-label {
  color: var(--text-soft);
  font-size: 0.78rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.form-control {
  width: 100%;
  border-radius: 14px;
  padding: 11px 12px;
  background: var(--surface-soft-2);
  color: var(--text);
  border: 1px solid var(--line);
  outline: none;
}

.form-control:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(51,102,255,0.14);
}

.form-button {
  width: auto;
  align-self: flex-start;
}

.assistant-output {
  background: var(--surface);
}

.assistant-output-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ai-brand {
  background: var(--ai-soft);
  color: var(--ai-color);
  border-radius: 14px;
  padding: 8px 11px;
  font-weight: 800;
  font-size: 0.78rem;
}

.recommendation-result {
  padding-top: 20px;
}

.recommendation-heading {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.result-category {
  color: var(--primary);
  font-weight: 800;
  font-size: 0.82rem;
  text-transform: uppercase;
}

.recommendation-heading h3 {
  font-size: clamp(1.8rem, 2vw, 2.1rem);
  margin: 0 0 20px;
  line-height: 1.2;
}

.recommendation-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.recommendation-row {
  border-top: 1px solid var(--line-soft);
  padding-top: 14px;
}

.recommendation-label {
  display: block;
  color: var(--text-muted);
  font-weight: 800;
  font-size: 0.78rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.recommendation-value {
  display: block;
  margin-top: 8px;
  color: var(--text);
  font-weight: 600;
  font-size: 0.96rem;
}

.ai-badge-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 26px;
}

.small-badge {
  background: var(--primary-soft);
  color: var(--primary-dark);
  border-radius: 14px;
  padding: 8px 12px;
  font-size: 0.76rem;
  font-weight: 700;
}

.small-badge.light {
  background: var(--surface-soft);
  color: var(--text-soft);
}

.pulse-grid {
  display: grid;
  grid-template-columns: minmax(360px, 0.92fr) minmax(420px, 1.08fr);
  gap: 20px;
}

.pulse-form-card,
.insights-card {
  background: var(--surface);
}

.pulse-form {
  margin-top: 20px;
}

.pulse-form textarea {
  min-height: 110px;
}

.insights-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-top: 20px;
}

.insight-item {
  padding: 16px 0;
  border-bottom: 1px solid var(--line-soft);
}

.insight-item:last-child {
  border-bottom: none;
}

.insight-tech {
  display: inline-block;
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 800;
  font-size: 0.74rem;
  padding: 8px 12px;
  border-radius: 12px;
  margin-right: 10px;
}

.insight-text {
  color: var(--text-soft);
  font-size: 0.86rem;
}

.lead-stat-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(160px, 1fr));
  gap: 16px;
  margin-top: 16px;
}

.stat-card {
  padding: 22px 18px;
}

.stat-tag {
  color: var(--text-muted);
  font-size: 0.76rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.11em;
}

.stat-number {
  display: block;
  font-size: 2rem;
  font-weight: 700;
  margin-top: 16px;
  color: var(--text);
}

.stat-trend {
  display: inline-block;
  margin-top: 12px;
  font-size: 0.74rem;
  font-weight: 800;
}

.stat-trend.positive {
  color: var(--secondary-dark);
}

.stat-trend.warning {
  color: var(--warning);
}

.lead-grid {
  display: grid;
  grid-template-columns: minmax(420px, 1fr) minmax(280px, 0.85fr);
  gap: 20px;
  margin-top: 20px;
}

.ai-insight-summary {
  margin-top: 16px;
}

.ai-insight-text {
  margin: 0 0 20px;
  font-size: 1rem;
  color: var(--text-soft);
  line-height: 1.7;
}

.suggested-activity {
  background: var(--surface-soft);
  border-radius: 20px;
  border: 1px solid var(--line);
  padding: 16px;
}

.suggested-label {
  color: var(--text-muted);
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.11em;
  text-transform: uppercase;
}

.suggested-activity h4 {
  margin: 14px 0 0;
  font-size: 1.2rem;
  color: var(--text);
}

.ai-final-note {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 0.84rem;
  color: var(--text-soft);
  background: var(--warning-soft);
  padding: 12px;
  border-radius: 14px;
  margin-top: 16px;
}

.note-icon {
  color: var(--warning);
}

.ai-badge {
  color: var(--ai-color);
  background: var(--ai-soft);
  border-radius: 14px;
  padding: 8px 12px;
  font-weight: 800;
  font-size: 0.72rem;
}

.suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-top: 16px;
}

.suggestion-item {
  padding: 14px 0;
  border-bottom: 1px solid var(--line-soft);
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-title {
  display: block;
  font-weight: 700;
  color: var(--text);
}

.suggestion-meta {
  display: block;
  color: var(--text-muted);
  font-size: 0.78rem;
}

@media (max-width: 1024px) {
  .app-shell {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    height: auto;
    position: relative;
  }

  .sidebar-footer {
    position: relative;
    bottom: auto;
    left: auto;
    right: auto;
  }

  .sidebar-nav {
    flex-wrap: wrap;
    flex-direction: row;
  }

  .dashboard-grid,
  .events-grid,
  .guide-grid,
  .assistant-grid,
  .pulse-grid,
  .lead-grid,
  .lead-stat-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 760px) {
  .main-content {
    padding: 16px;
  }

  .topbar,
  .section-header,
  .dashboard-grid,
  .events-grid,
  .guide-grid,
  .assistant-grid,
  .pulse-grid,
  .lead-grid,
  .lead-stat-grid {
    grid-template-columns: 1fr;
    flex-direction: column;
  }

  .page-section {
    padding: 18px;
  }

  .nav-link {
    flex: 1 1 auto;
  }

  .sidebar-nav {
    flex-direction: column;
  }

  .events-grid {
    display: grid;
  }
}
